generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Clan {
  id Int @id @default(autoincrement())
  tag String @unique
  name String 
  description String?
  requiredTownhallLevel Int
  warFrequency WarFrequency
  clanLevel Int
  warWinStreak Int
  warWins Int
  warTies Int
  warLosses Int
  clanPoints Int
  clanBuilderBasePoints Int
  clanCapitalPoints Int
  isFamilyFriendly Boolean
  requiredTrophies Int
  requiredBuilderBaseTrophies Int
  isWarLogPublic Boolean
  type ClanType
  members Int
  warLeagueId   Int?
  warLeagueName String?
  capitalLeagueId   Int?
  capitalLeagueName String?
  chatLanguageId   Int?
  chatLanguageName String?
  requiredLeagueTierId   Int?
  requiredLeagueTierName String?
  locationId          Int?
  locationName        String?
  locationIsCountry   Boolean?
  locationCountryCode String?
  badgeSmallUrl  String?
  badgeMediumUrl String?
  badgeLargeUrl  String?
}

model ClanLabel {
  id      Int    @id @default(autoincrement())
  clanId  Int
  labelId Int
  name    String
}

enum WarFrequency {
  UNKNOWN
  ALWAYS
  MORE_THAN_ONCE_PER_WEEK
  ONCE_PER_WEEK
  LESS_THAN_ONCE_PER_WEEK
  NEVER
  ANY
}

enum ClanType {
    OPEN
    INVITE_ONLY
    CLOSED
}